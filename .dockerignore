# 빌드 컨텍스트에서 제외 — 이미지 크기와 빌드 시간을 줄인다.
.git
.github
__pycache__
*.pyc
.pytest_cache
.superpowers

# 데이터셋·학습 산출물 (수 GB). 서버는 추론만 한다.
data/
model_training/
runs/
test_videos/
*.joblib
*.pt

# 프런트는 Dockerfile 1단계에서 새로 빌드한다
webservice/frontend/node_modules/
webservice/frontend/dist/

# 로컬 상태
webservice/daon.db
webservice/consulting/uploads/
webservice/consulting/reports/
calibration.json
fall_risk_log*.csv
bench/

# 문서·미디어
docs/
pictures/
hardware/
*.md
*.jpeg
*.png
*.mov
*.mp4
.DS_Store

# ── 위 확장자 제외에서 되살릴 것들 ──────────────────────────────────────────
# 앱이 실제로 서빙하는 자산이라 이미지에 반드시 들어가야 한다.
# (이 negation 이 없으면 평면도가 404 나고 샘플 캐시 이미지가 깨진다.)
!webservice/data/**
!webservice/consulting/samples/**
!webservice/frontend/public/**
# 셀프캠 체험용 배포 모델. *.joblib 전체 제외에서 이 파일 하나만 되살린다 —
# 없으면 Dockerfile 의 COPY 가 "file not found" 로 빌드에서 실패한다.
!fall_risk_model_v5.joblib
